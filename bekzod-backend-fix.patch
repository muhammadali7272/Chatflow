+  // All unread DM counts, grouped per sender straight from Mongo — the
+  // sidebar's badge source at login/reconnect. NB: .aggregate() bypasses
+  // Mongoose's ObjectId auto-cast, so the match id must be cast manually.
+  socket.on("get-unread-counts", async () => {
+    try {
+      if (!socket.userId) {
+        socket.emit("unread-counts-all", { counts: {} });
+        return;
+      }
+
+      const rows = await Message.aggregate([
+        {
+          $match: {
+            receiverId: new mongoose.Types.ObjectId(socket.userId),
+            isSeen: false,
+            deleted: false,
+          },
+        },
+        { $group: { _id: "$senderId", count: { $sum: 1 } } },
+      ]);
+
+      const counts = {};
+      rows.forEach((r) => {
+        counts[r._id.toString()] = r.count;
+      });
+
+      socket.emit("unread-counts-all", { counts });
+    } catch (err) {
+      console.error("Error fetching unread counts:", err);
+      socket.emit("unread-counts-all", { counts: {} });
+    }
+  });
+
