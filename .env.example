# Copy to .env and adjust for your environment.
VITE_SOCKET_URL=https://your-backend.example.com
VITE_WS_AUTH=1

# Optional TURN relay for WebRTC calls. Leave empty to use STUN only — calls
# then work on a shared network but fail between different NATs (mobile data,
# corporate wifi), where the remote video stays black. Comma-separated urls.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
