{
  "description": "Filesystem MCP Server — provides secure, scoped read/write access to local directories",
  "package": "@modelcontextprotocol/server-filesystem",
  "install": "npx -y @modelcontextprotocol/server-filesystem",
  "setup": {
    "steps": [
      "Install the server: npx -y @modelcontextprotocol/server-filesystem",
      "Configure allowed directories in the args list",
      "Restart your MCP client application"
    ],
    "requirements": ["Node.js 18+"],
    "notes": "Access is scoped to only the directories you explicitly allow. Each operation requires manual approval in most clients."
  },
  "configuration": {
    "mcpServers": {
      "filesystem": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/Users/username/projects",
          "/Users/username/documents"
        ]
      }
    }
  },
  "use_cases": [
    "Read and edit project files",
    "Create new files and directories",
    "Search file contents",
    "List directory structures"
  ],
  "platform_configs": {
    "macos": {
      "config_path": "~/Library/Application Support/Claude/claude_desktop_config.json"
    },
    "windows": {
      "config_path": "%APPDATA%\\Claude\\claude_desktop_config.json"
    },
    "linux": {
      "config_path": "~/.config/Claude/claude_desktop_config.json"
    }
  }
}
