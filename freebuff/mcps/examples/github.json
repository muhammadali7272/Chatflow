{
  "description": "GitHub MCP Server — manage repositories, issues, pull requests, and more via the GitHub API",
  "package": "@modelcontextprotocol/server-github",
  "install": "npx -y @modelcontextprotocol/server-github",
  "setup": {
    "steps": [
      "Create a GitHub Personal Access Token (classic) with repo scope",
      "Install the server: npx -y @modelcontextprotocol/server-github",
      "Add your GITHUB_TOKEN to the environment variables",
      "Restart your MCP client application"
    ],
    "requirements": ["Node.js 18+", "GitHub Personal Access Token"],
    "notes": "Use a fine-grained token scoped to only the repos you need. Never hardcode tokens in shared configs."
  },
  "configuration": {
    "mcpServers": {
      "github": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": {
          "GITHUB_TOKEN": "ghp_xxxxxxxxxxxxxxxxxxxx"
        }
      }
    }
  },
  "toolsets": {
    "description": "Some GitHub MCP implementations support toolset filtering to reduce token overhead",
    "available": ["repos", "issues", "pulls", "commits", "users"],
    "recommended": ["repos", "issues", "pulls"]
  },
  "use_cases": [
    "Search repositories and read code",
    "Create and manage issues",
    "Review and merge pull requests",
    "View commit histories and diffs",
    "List repository contents and file structures"
  ],
  "platform_configs": {
    "macos": {
      "config_path": "~/Library/Application Support/Claude/claude_desktop_config.json"
    },
    "windows": {
      "config_path": "%APPDATA%\\Claude\\claude_desktop_config.json"
    },
    "linux": {
      "config_path": "~/.config/Claude/claude_desktop_config.json"
    }
  }
}
