{
  "description": "Brave Search MCP Server — enables web search and local search via the Brave Search API",
  "package": "@modelcontextprotocol/server-brave-search",
  "install": "npx -y @modelcontextprotocol/server-brave-search",
  "setup": {
    "steps": [
      "Sign up for a free Brave Search API key at https://brave.com/search/api/",
      "Install the server: npx -y @modelcontextprotocol/server-brave-search",
      "Add your BRAVE_API_KEY to the environment variables",
      "Restart your MCP client application"
    ],
    "requirements": ["Node.js 18+", "Brave Search API key"],
    "notes": "The free tier includes 2,000 queries/month, sufficient for most development use cases."
  },
  "configuration": {
    "mcpServers": {
      "brave-search": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-brave-search"],
        "env": {
          "BRAVE_API_KEY": "BSA_xxxxxxxxxxxxxxxxxxxx"
        }
      }
    }
  },
  "use_cases": [
    "Search the web for documentation and tutorials",
    "Find current information and news",
    "Perform local search (businesses, places)",
    "Research technical topics in real-time"
  ],
  "platform_configs": {
    "macos": {
      "config_path": "~/Library/Application Support/Claude/claude_desktop_config.json"
    },
    "windows": {
      "config_path": "%APPDATA%\\Claude\\claude_desktop_config.json"
    },
    "linux": {
      "config_path": "~/.config/Claude/claude_desktop_config.json"
    }
  }
}
