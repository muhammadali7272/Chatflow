{
  "agent": {
    "name": "code-reviewer",
    "version": "1.0.0",
    "description": "Reviews code changes and provides critical feedback"
  },
  "model": {
    "preferred": "deepseek/deepseek-v4-flash",
    "fallback": "gpt-4o-mini"
  },
  "behavior": {
    "tone": "critical-but-constructive",
    "focus": ["bugs", "logic-errors", "security-issues", "style-violations", "inconsistencies"],
    "skip_patterns": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**"
    ],
    "max_files_per_review": 20,
    "require_approval_for": ["security-changes", "breaking-changes"]
  },
  "workflow": {
    "auto_review_on_commit": false,
    "auto_review_on_pr": true,
    "post_review_action": "flag-for-human-review"
  },
  "output": {
    "format": "structured-markdown",
    "include_line_numbers": true,
    "include_snippets": true,
    "severity_levels": ["critical", "warning", "suggestion"]
  }
}
