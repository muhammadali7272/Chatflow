+// ── Presence helpers ────────────────────────────────────────────────────────
+// A user may be connected from several tabs/devices at once, so each userId
+// maps to a Set of socketIds. They only become "offline" once the LAST socket
+// disconnects — never on the first tab close.
+function addUserSocket(userId, socketId) {
+  userId = String(userId)
+  const isFirst = !onlineUsers.has(userId) || onlineUsers.get(userId).size === 0
+  if (!onlineUsers.has(userId)) onlineUsers.set(userId, new Set())
+  onlineUsers.get(userId).add(socketId)
+  return isFirst // true only when this is the user's first live connection
+}
+
+function removeUserSocket(userId, socketId) {
+  userId = String(userId)
+  const sockets = onlineUsers.get(userId)
+  if (!sockets) return false
+  sockets.delete(socketId)
+  if (sockets.size === 0) {
+    onlineUsers.delete(userId)
+    return true // that was the user's last connection — now truly offline
+  }
+  return false
+}
+
+// Deliver an event to every socket a user currently has open.
+function emitToUser(userId, event, payload) {
+  const sockets = onlineUsers.get(String(userId))
+  if (!sockets) return
+  for (const socketId of sockets) io.to(socketId).emit(event, payload)
+}
+
+// Register a socket as belonging to userId and broadcast presence changes.
+function registerPresence(socket, userId) {
+  if (!userId) return
+  userId = String(userId)
+  socket.userId = userId
+  const isFirst = addUserSocket(userId, socket.id)
+  if (isFirst) io.emit('user:online', { userId })
+  // Full snapshot too — lets a freshly connected (or older) client sync the
+  // whole online list in one shot.
+  io.emit('users:online', Array.from(onlineUsers.keys()))
+}
+
