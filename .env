# Socket.IO backend (see /prod). Use https:// in production.
VITE_SOCKET_URL=https://chat-backend-nl2o.onrender.com/

# Set to 1 to send the auth token in the Socket.IO handshake.
VITE_WS_AUTH=0

# TURN relay for WebRTC calls. Empty = STUN only: ICE then gathers just `host`
# and `srflx` candidates, so a call between two different NATs (mobile data,
# corporate wifi) connects to nothing and the remote video stays black.
# Adding a relay needs all three values; comma-separated urls are allowed.
#
# Leave them EMPTY here — this file is committed. Real credentials belong in
# .env.local (gitignored, wins over this file) for local dev, and in the host's
# environment panel for a deployed build. Anything written here ships to every
# collaborator with repo access.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
